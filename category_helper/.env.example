# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# openai | anthropic | gemini | openai_compatible | azure_openai | custom
# Aliases: gpt -> openai, claude -> anthropic, google -> gemini, azure -> azure_openai
LLM_PROVIDER=anthropic

# Empty = the provider's own default (openai: gpt-4o, anthropic: claude-opus-5,
# gemini: gemini-3-flash-preview). Required for openai_compatible/azure_openai.
LLM_MODEL=

# Shared generation settings.
LLM_MAX_OUTPUT_TOKENS=1024
LLM_USE_WEB_SEARCH=false
LLM_TIMEOUT_SECONDS=60
# The worker has its own backoff, so let the SDK fail fast.
LLM_MAX_RETRIES=0

# Escape hatches (JSON objects).
#   LLM_EXTRA_JSON   -> passed to the SDK client constructor
#   LLM_OPTIONS_JSON -> passed to the generate() call, e.g. {"effort":"low"}
LLM_EXTRA_JSON=
LLM_OPTIONS_JSON=

# One key for whichever provider is selected; the per-provider keys below are
# used as fallbacks so existing setups keep working.
LLM_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- openai_compatible: Groq / DeepSeek / xAI / Mistral / Together / Fireworks
# --- OpenRouter / Ollama / LM Studio / vLLM ---------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_COMPATIBLE_API_KEY=
# How JSON is requested: schema | object | off   (object is the safest default)
# LLM_JSON_MODE=object

# --- azure_openai ----------------------------------------------------------
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>

# --- your own adapter ------------------------------------------------------
# See llm/providers/_template.py
# LLM_PROVIDER=custom
# LLM_CUSTOM_PROVIDER=my_package.my_module:MyProvider

# ---------------------------------------------------------------------------
# Background watcher (starts with the web server)
# ---------------------------------------------------------------------------
CATEGORY_BATCH_SIZE=10
CATEGORY_POLL_SECONDS=2
CATEGORY_RETRY_SECONDS=10
